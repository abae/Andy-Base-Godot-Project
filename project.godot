; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="HelpingHand"
run/main_scene="uid://cexgbli1oifoi"
config/features=PackedStringArray("4.5")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
boot_splash/fullsize=false
config/icon="res://icon.png"

[autoload]

God="*res://control/global/God.gd"
GameState="*res://control/global/GameState.tscn"
Transition="*res://control/global/Transition.tscn"
MusicController="*res://control/global/MusicController.tscn"
Dialogic="*res://addons/dialogic/Core/DialogicGameHandler.gd"

[dialogic]

directories/dch_directory={
"Bear": "res://hud/dialogue/Bear.dch",
"Bunny": "res://hud/dialogue/Bunny.dch",
"Fox": "res://hud/dialogue/Fox.dch",
"Hedgehog": "res://hud/dialogue/Hedgehog.dch",
"Mouse": "res://hud/dialogue/Mouse.dch",
"Skunk": "res://hud/dialogue/Skunk.dch",
"Squirrel": "res://hud/dialogue/Squirrel.dch",
"player": "res://player/player.dch",
"testnpc": "res://props/testnpc.dch",
"unknown": "res://hud/dialogue/unknown.dch"
}
directories/dtl_directory={
"bear": "res://hud/dialogue/bear.dtl",
"bearHouse": "res://hud/dialogue/bearHouse.dtl",
"bunny": "res://hud/dialogue/bunny.dtl",
"bunnyHouse": "res://hud/dialogue/bunnyHouse.dtl",
"fox": "res://hud/dialogue/fox.dtl",
"foxHouse": "res://hud/dialogue/foxHouse.dtl",
"hedgehog": "res://hud/dialogue/hedgehog.dtl",
"hedgehogHouse": "res://hud/dialogue/hedgehogHouse.dtl",
"mouse": "res://hud/dialogue/mouse.dtl",
"mouseHouse": "res://hud/dialogue/mouseHouse.dtl",
"skunk": "res://hud/dialogue/skunk.dtl",
"skunkHouse": "res://hud/dialogue/skunkHouse.dtl",
"squirrel": "res://hud/dialogue/squirrel.dtl",
"squirrelHouse": "res://hud/dialogue/squirrelHouse.dtl",
"testTimeline": "res://props/testTimeline.dtl",
"timeline": "res://timeline.dtl"
}
variables={
"bearBunny": false,
"bearFox": false,
"bearHedgehog": false,
"bearKey": false,
"bearMouse": false,
"bearOpen": false,
"bearOptionalResponse1": false,
"bearOptionalResponse2": false,
"bearSkunk": false,
"bearSquirrel": false,
"bunnyKey": false,
"bunnyOpen": false,
"foxKey": false,
"foxOpen": false,
"gameEnd": false,
"hedgehogOpen": false,
"mouseKey": false,
"mouseKey2": false,
"mouseOpen": false,
"skunkBunnyMention": false,
"skunkFoxMention": false,
"skunkHedgehogMention": false,
"skunkKey": false,
"skunkKey2": false,
"skunkKey3": false,
"skunkKey4": false,
"skunkKey5": false,
"skunkKey6": false,
"skunkMouseMention": false,
"skunkNamesMentioned": 0,
"skunkOpen": false,
"skunkSquirrelMention": false,
"squirrelKey": false,
"squirrelKey2": false,
"squirrelKey3": false,
"squirrelKey4": false,
"squirrelKey5": false,
"squirrelOpen": false
}
glossary/default_case_sensitive=true
extensions_folder="res://addons/dialogic_additions"
text/letter_speed=0.01
text/initial_text_reveal_skippable=true
text/text_reveal_skip_delay=0.1
text/advance_delay=0.1
text/autoadvance_per_character_delay=0.15
text/autoadvance_ignored_characters_enabled=true
animations/join_default_length=0.5
animations/join_default_wait=true
animations/leave_default_length=0.0
animations/leave_default_wait=true
animations/cross_fade_default_length=0.5
save/autosave_delay=60.0
save/encryption_on_exports_only=true
choices/autofocus_first=true
choices/delay=0.2
choices/reveal_delay=0
choices/reveal_by_input=false
text/autopauses={}
audio/channel_defaults={
"": {
"audio_bus": "",
"fade_length": 0.0,
"loop": false,
"volume": 0.0
},
"music": {
"audio_bus": "",
"fade_length": 0.0,
"loop": true,
"volume": 0.0
}
}
animations/leave_default="Fade Out Down"
layout/default_style="res://hud/dialogue/dialogue_style.tres"
layout/style_directory={
"": "res://hud/dialogue/dialogue_style.tres",
"dialogue_style": "res://hud/dialogue/dialogue_style.tres"
}
layout/style_list=["res://hud/dialogue/dialogue_style.tres"]

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=4
window/size/resizable=false
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogic/plugin.cfg", "res://addons/nklbdev.aseprite_importers/plugin.cfg")

[importer_defaults]

texture={
"compress/bptc_ldr": 0,
"compress/hdr_mode": 0,
"compress/lossy_quality": 0.7,
"compress/mode": 0,
"compress/normal_map": 0,
"detect_3d": false,
"flags/anisotropic": false,
"flags/filter": false,
"flags/mipmaps": false,
"flags/repeat": 0,
"flags/srgb": 2,
"process/HDR_as_SRGB": false,
"process/fix_alpha_border": true,
"process/invert_color": false,
"process/premult_alpha": false,
"size_limit": 0,
"stream": false,
"svg/scale": 1.0
}
aseprite.wizard.plugin={
"animated_texture/filename_pattern": "{basename}.{layer}.{animation}.Texture.{extension}",
"animated_texture/frame_filename_pattern": "{basename}.{layer}.{animation}.{frame}.Texture.{extension}",
"animated_texture/import_animated_texture": false,
"exclude_layers_pattern": "",
"only_visible_layers": false,
"split_layers": false,
"sprite_filename_pattern": "{basename}.{layer}.{extension}",
"texture_atlas/filename_pattern": "{basename}.{layer}.Atlas.{extension}",
"texture_atlas/frame_filename_pattern": "{basename}.{layer}.{animation}.{frame}.Atlas.{extension}",
"texture_atlas/import_texture_atlas": false,
"texture_strip/filename_pattern": "{basename}.{layer}.Strip.{extension}",
"texture_strip/import_texture_strip": false,
"trim_images": false
}

